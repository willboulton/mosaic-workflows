configfile: "config/config.yaml"

include: "rules/00_utils.smk"
include: "rules/02_read_taxonomy.smk"
include: "rules/03_mapping_assembly.smk"
include: "rules/04_binning.smk"
include: "rules/05_bin_qc.smk"
#include: "rules/comebin.smk"


localrules: all

wildcard_constraints:
        batch="[EIST]\d\d_(\d)+",
        sample="33000\d\d\d\d\d",
        binner="vamb|semibin|metabat"


def select_samples(wc):
    from itertools import product
    filter_samples = [s for s in samples if s.batch in run_batch]
    samples_x_rg = list(product(filter_samples, ["1", "2"]))
    return [ f"{fastq_tmpdir}/{s.batch}/{s.img_taxon_id}-filter-METAG_{r}.fastq.gz" for s, r in samples_x_rg ]

def select_samples_2(wc):
    filter_samples = [ s for s in samples if s.batch in run_batch ]
    return (
        list(set(f"{assembly_dir}/{s.batch}/megahit" for s in filter_samples)) + 
        [ f"{binning_dir}/{s.img_taxon_id}/metabat" for s in filter_samples ] + 
        [ f"{binning_dir}/{s.img_taxon_id}/vamb" for s in filter_samples ] + 
        [ f"{binning_dir}/{s.img_taxon_id}/semibin" for s in filter_samples ]
    )

def select_samples_3(wc):
    filter_samples = [ s for s in samples if s.batch in run_batch ]
    return [ f"{taxo_tmpdir}/{s.img_taxon_id}/{s.img_taxon_id}.a.euks.txt" for s in filter_samples ]

def select_samples_4(wc):
    filter_samples = [ s for s in samples if s.batch in run_batch ]
    return (
        list(set(f"{binning_dir}/{s.batch}/{s.batch}.euks.fna" for s in filter_samples)) + 
        list(set(f"{assembly_dir}/{s.batch}/megahit" for s in filter_samples))
    )

def select_samples_5(wc):
    filter_samples = [ s for s in samples if s.batch in run_batch ]
    return ([ f"{bam_tmpdir}/{s.batch}/bam_multia/{s.img_taxon_id}_x_{s.batch}_euks_strobalign.sorted.bam" for s in filter_samples ] + 
            [ f"{bam_tmpdir}/{s.batch}/bam_coa/{s.img_taxon_id}_x_{s.batch}_euks_coa.sorted.bam" for s in filter_samples ]
    )

def select_samples_6(wc):
    filter_samples = [ s for s in samples if s.batch in run_batch ]
    return (
        list(set(f"{binning_dir}/{s.batch}/{s.batch}.euks_multi.jgi_cov.npz" for s in filter_samples)) + 
        list(set(f"{binning_dir}/{s.batch}/{s.batch}.euks_coa.jgi_cov.npz" for s in filter_samples))
    )

def select_samples_7(wc):
    filter_samples = [ s for s in samples if s.batch in run_batch ]
    return (
        list(set(f"{bam_tmpdir}/{s.batch}/vamb_coa/latent.npz" for s in filter_samples)) + 
        list(set(f"{bam_tmpdir}/{s.batch}/vamb_multi/latent.npz" for s in filter_samples)) #+ 
        #list(set(f"{bam_tmpdir}/{s.batch}/metabat_coa" for s in filter_samples)) + 
        #list(set(f"{bam_tmpdir}/{s.batch}/metabat_multi" for s in filter_samples)) 
    )

def select_samples_8(wc):
    filter_samples = [ s for s in samples if str(s.img_taxon_id) == "3300046532" ]
    return [ f"{binning_dir}/{s.img_taxon_id}/comebin/bins" for s in filter_samples ]

def select_samples_9(wc):
    filter_samples = [ s for s in samples if str(s.img_taxon_id) == "3300046532" ]
    return ([ f"{binning_dir}/{s.img_taxon_id}/comebin/comebin_out" for s in filter_samples ] + 
        list(set([ f"{binning_dir}/E04_1/comebin_multi/comebin_out" for s in filter_samples ] )) + 
        list(set([ f"{binning_dir}/E04_1/comebin_coa/comebin_out" for s in filter_samples ] ))
    )

def select_samples_10(wc):
    filter_samples = [ s for s in samples if s.batch in run_batch ]
    return (
        list(set(f"{binning_dir}/{s.batch}/{s.batch}.euks_multi.jgi_cov.npz" for s in filter_samples)) + 
        [ f"{binning_dir}/{s.img_taxon_id}/bins_checkm" for s in filter_samples ] + 
        [ f"{binning_dir}/{s.img_taxon_id}/ebins_eukcc" for s in filter_samples ]
    )

onstart:
    print("starting")
    print("********")
    shell(f"mkdir -p {binning_dir}")
    
    for b in run_batch:
        shell(f"mkdir -p {assembly_dir}/{b}")
        shell(f"mkdir -p {binning_dir}/{b}")
        shell(f"mkdir -p {bam_tmpdir}/{b}/bam_multia")
        shell(f"mkdir -p {bam_tmpdir}/{b}/bam_coa")

    for s in samples:
        if s.batch in run_batch:
            shell(f"mkdir -p {fastq_tmpdir}/{s.img_taxon_id}")
            shell(f"mkdir -p {taxo_tmpdir}/{s.img_taxon_id}")
            shell(f"mkdir -p {bam_tmpdir}/{s.img_taxon_id}/bam")

rule all:
    input: select_samples_10
