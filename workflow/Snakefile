configfile: "config/config.yaml"

include: "rules/02_read_taxonomy.smk"

localrules: all

wildcard_constraints:
        batch="[EIST]\d\d_(\d)+",
        sample="33000\d\d\d\d\d"


def select_samples(wc):
    from itertools import product
    filter_samples = [s for s in samples if s.batch in run_batch]
    samples_x_rg = list(product(filter_samples, ["1", "2"]))
    return [ f"{fastq_tmpdir}/{s.batch}/{s.img_taxon_id}-filter-METAG_{r}.fastq.gz" for s, r in samples_x_rg ]

def select_samples_2(wc):
    filter_samples = [s for s in samples if s.batch in run_batch]
    return (
        [ f"{taxo_tmpdir}/{s.batch}/{s.img_taxon_id}.fastq.cf" for s in filter_samples ] + 
        [ f"{taxo_tmpdir}/{s.batch}/{s.img_taxon_id}.faa.mms2lca" for s in filter_samples ] + 
        [ f"{bam_tmpdir}/{s.batch}/{s.img_taxon_id}.sorted.bam" for s in filter_samples ] +
        [ f"{binning_dir}/{s.img_taxon_id}/metabat" for s in samples ]
    )

onstart:
    print("starting")
    print("********")
    shell(f"mkdir -p {binning_dir}")
    for b in run_batch:
        shell(f"mkdir -p {fastq_tmpdir}/{b}")
        shell(f"mkdir -p {taxo_tmpdir}/{b}")
        shell(f"mkdir -p {bam_tmpdir}/{b}")


rule all:
    input: select_samples_2
