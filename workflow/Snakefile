configfile: "config/config.yaml"

include: "rules/00_utils.smk"
include: "rules/02_read_taxonomy.smk"
include: "rules/03_mapping_assembly.smk"
include: "rules/04_binning.smk"
include: "rules/05_bin_qc.smk"

localrules: all

wildcard_constraints:
        batch="[EIST]\d\d_(\d)+",
        sample="33000\d\d\d\d\d",
        binner="vamb|comebin|metabat|vacuum"


def select_samples(wc):
    from itertools import product
    filter_samples = [s for s in samples if s.batch in run_batch]
    samples_x_rg = list(product(filter_samples, ["1", "2"]))
    return [ f"{fastq_tmpdir}/{s.batch}/{s.img_taxon_id}-filter-METAG_{r}.fastq.gz" for s, r in samples_x_rg ]

def select_samples_2(wc):
    filter_samples = [s for s in samples if s.batch in run_batch]
    return (
        list(set(f"{assembly_dir}/{s.batch}/megahit" for s in filter_samples)) #+ 
        #[ f"{binning_dir}/{s.img_taxon_id}/metabat_checkm" for s in filter_samples ] + 
        #[ f"{binning_dir}/{s.img_taxon_id}/comebin_checkm" for s in filter_samples ] + 
        #[ f"{binning_dir}/{s.img_taxon_id}/vamb_checkm" for s in filter_samples ] + 
        #[ f"{binning_dir}/{s.img_taxon_id}/vacuum_checkm" for s in filter_samples ]
    )

onstart:
    print("starting")
    print("********")
    shell(f"mkdir -p {binning_dir}")
    
    for b in run_batch:
        shell(f"mkdir -p {assembly_dir}/{b}")

    for s in samples:
        if s.batch in run_batch:
            shell(f"mkdir -p {fastq_tmpdir}/{s.img_taxon_id}")
            shell(f"mkdir -p {taxo_tmpdir}/{s.img_taxon_id}")
            shell(f"mkdir -p {bam_tmpdir}/{s.img_taxon_id}")

rule all:
    input: select_samples_2
